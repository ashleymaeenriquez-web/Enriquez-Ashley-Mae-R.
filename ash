
# PYTHON PROGRAMMING QUIZ GAME
# A quiz game that tests basic Python knowledge.

quiz = {
    "Basic Syntax": [
        ["Which function displays output?", "input()", "print()", "type()", "int()", "B"],
        ["Which symbol is used for comments?", "//", "#", "/*", "&", "B"],
        ["Which language is Python?", "Programming language", "Markup language", "Database", "Operating system", "A"],
        ["Which function gets user input?", "print()", "input()", "range()", "type()", "B"],
        ["Which symbol is used for assignment?", "==", "=", "!=", ">=", "B"],
        ["Which is a valid Python variable name?", "2name", "my-name", "my_name", "my name", "C"],
        ["What does float do?", "Display decimal numbers", "Prints output", "Gets input", "Adds numbers", "A"],
        ["Which function converts a value to an integer?", "str()", "float()", "int()", "bool()", "C"],
        ["What is the correct way to print Hello?", "print(Hello)", "print('Hello')", "output('Hello')", "display('Hello')", "B"],
        ["Which extension is used for Python files?", ".html", ".java", ".py", ".css", "C"]
    ],

    "Variables and Data Types": [
        ["Which data type stores whole numbers?", "str", "int", "float", "bool", "B"],
        ["Which data type stores decimal numbers?", "int", "str", "float", "bool", "C"],
        ["Which data type stores text?", "int", "float", "str", "bool", "C"],
        ["What is the value of x in x = 10?", "5", "10", "15", "20", "B"],
        ["Which value represents True or False?", "str", "int", "bool", "float", "C"],
        ["Which function identifies a variable's data type?", "type()", "input()", "print()", "len()", "A"],
        ["What is the result of 10 + 5?", "10", "15", "20", "25", "B"],
        ["Which operator is used for multiplication?", "+", "-", "*", "/", "C"],
        ["What is the result of 10 % 3?", "1", "2", "3", "0", "A"],
        ["What is the result of 2 ** 3?", "5", "6", "8", "9", "C"]
    ],

    "Conditionals and Logical Operators": [
        ["Which keyword starts a conditional statement?", "for", "if", "while", "def", "B"],
        ["Which keyword checks another condition?", "else", "elif", "break", "continue", "B"],
        ["Which keyword runs when previous conditions are false?", "if", "elif", "else", "while", "C"],
        ["Which operator means AND?", "or", "not", "and", "==", "C"],
        ["Which operator means OR?", "and", "or", "not", "!=", "B"],
        ["Which operator reverses a Boolean value?", "and", "or", "not", "==", "C"],
        ["What does == mean?", "Assignment", "Equal comparison", "Addition", "Subtraction", "B"],
        ["What does != mean?", "Equal", "Greater than", "Not equal", "Less than", "C"],
        ["What will print if 5 > 3 is true?", "False", "True", "None", "Error", "B"],
        ["Which statement checks if x is greater than 10?", "if x = 10:", "if x > 10:", "if x < 10:", "if x == 10:", "B"]
    ],

    "Loops and Iteration": [
        ["Which loop repeats through a sequence?", "if", "else", "for", "break", "C"],
        ["Which loop repeats while a condition is true?", "for", "while", "if", "elif", "B"],
