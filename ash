}

# Main program
while True:

    print("\n===================================")
    print("       PYTHON PROGRAMMING QUIZ")
    print("===================================")

    print("\nChoose a quiz category:")
    print("1. Basic Python Syntax")
    print("2. Variables and Data Types")
    print("3. Conditionals and Logical Operators")
    print("4. Loops and Iteration")

    choice = input("\nEnter your choice (1-4): ")

    # Select the category
    if choice == "1":
        subject = "Basic Syntax"
    elif choice == "2":
        subject = "Variables and Data Types"
    elif choice == "3":
        subject = "Conditionals and Logical Operators"
    elif choice == "4":
        subject = "Loops and Iteration"
    else:
        print("Invalid choice. Please try again.")
        continue

    questions = quiz[subject]
    score = 0
    question_number = 1

    print("\nCategory:", subject)
    print("Number of questions: 10")

    # Display and process questions
    for question in questions:

        print("\nQuestion", question_number)
        print(question[0])
        print("A.", question[1])
        print("B.", question[2])
        print("C.", question[3])
        print("D.", question[4])

        answer = input("Your answer: ").upper()

        # Check the answer
        if answer == question[5]:
            print("Correct!")
            score = score + 1
        elif answer in ["A", "B", "C", "D"]:
            print("Incorrect!")
            print("Correct answer:", question[5])
        else:
            print("Invalid answer. No points earned.")

        question_number = question_number + 1

    # Calculate results
    total_questions = 10
    percentage = (score / total_questions) * 100

    print("\n===================================")
    print("             QUIZ RESULTS")
    print("===================================")

    print("Category:", subject)
    print("Total questions:", total_questions)
    print("Correct answers:", score)
    print("Incorrect answers:", total_questions - score)
    print("Percentage:", percentage, "%")

    # Display remarks
    if score >= 8:
        print("Remarks: Excellent!")
    elif score >= 5:
        print("Remarks: Good job!")
    else:
        print("Remarks: Keep practicing!")

    print("\n===================================")

    # Ask the player to play again
    play_again = input("Do you want to play again? (yes/no): ").lower()

    if play_again != "yes":
        print("\nThank you for playing!")
        print("Keep practicing Python programming!")
        break
    